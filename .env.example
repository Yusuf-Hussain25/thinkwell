# ── Clerk (auth) ── https://dashboard.clerk.com → your app → Configure → API keys
# Leave both empty in local dev to use Clerk "keyless" mode (temporary keys, no account needed).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (syncs users into MongoDB)
# Clerk dashboard → Configure → Webhooks → Add endpoint https://<your-domain>/api/clerk
# subscribe to user.created / user.updated / user.deleted → copy "Signing Secret" (whsec_...)
SIGNING_SECRET=

# ── MongoDB ── local: mongodb://127.0.0.1:27017/thinkwell  ·  cloud: MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb://127.0.0.1:27017/thinkwell

# ── DeepSeek (AI replies) ── https://platform.deepseek.com/api_keys → Create new API key
DEEPSEEK_API_KEY=
